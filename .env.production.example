# Northstar OKR — 生产环境配置模板（阿里云 RDS Supabase）
#
# 复制为 .env.production 并填入真实值。.env.production 已加入 .gitignore，
# 不会提交到 Git。构建期 `build:production` 会先运行 verify-supabase-config.mjs
# 校验这些值（拒绝占位值、service-role/secret key、非 HTTPS 域名）。
#
# 只放浏览器公开变量。以下内容严禁写入本文件或任何前端文件：
#   - service_role key（SUPABASE_SERVICE_ROLE_KEY）
#   - JWT secret
#   - 数据库密码（SUPABASE_DB_PASSWORD）
#   - DATABASE_URL

VITE_APP_MODE=supabase
VITE_SUPABASE_URL=https://<your-alibaba-rds-supabase-host>
VITE_SUPABASE_ANON_KEY=<your-publishable-anon-key>
