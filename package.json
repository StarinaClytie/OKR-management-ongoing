{
  "name": "time-tech-spectra-okr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "node scripts/build-production.mjs",
    "verify:config": "node scripts/verify-supabase-config.mjs",
    "test:smoke:real": "vitest run src/pages/pageFrameworks.test.tsx src/pages/KrProgressEditor.test.tsx src/app/routes.test.tsx src/i18n/LocaleProvider.test.tsx",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "server:dev": "tsx server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist-server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vitejs/plugin-react": "latest",
    "ali-oss": "^6.23.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.1",
    "jsdom": "29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
